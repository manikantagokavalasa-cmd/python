#Operations on Dictionaries
# Create a dictionary
students = {
    101: "Rahul",
    102: "Priya",
    103: "Arjun"
}

# Print all keys
print("Keys:")
for key in students.keys():
    print(key)

# Print all values
print("\nValues:")
for value in students.values():
    print(value)

# Print all key-value pairs
print("\nKey-Value Pairs:")
for key, value in students.items():
    print(key, ":", value)
#output:
Keys:
101
102
103
Values:
Rahul
Priya
Arjun
Key-Value Pairs:
101 : Rahul
102 : Priya
103 : Arjun

# Create a dictionary
students = {
    101: "Rahul",
    102: "Priya",
    103: "Arjun"
}

# Remove an existing key using pop()
removed_value = students.pop(102)

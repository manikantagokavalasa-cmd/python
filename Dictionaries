# Create two dictionaries
dict1 = {"a": 1, "b": 2}
dict2 = {"c": 3, "d": 4}

# Merge using update()
merged1 = dict1.copy()
merged1.update(dict2)
print("Using update():", merged1)

# Merge using the | operator (Python 3.9+)
merged2 = dict1 | dict2
print("Using | operator:", merged2)
#output:
Using update(): {'a': 1, 'b': 2, 'c': 3, 'd': 4}
Using | operator: {'a': 1, 'b': 2, 'c': 3, 'd': 4}

# Dictionary of item names and prices
items = {
    "Laptop": 55000,
    "Phone": 30000,
    "Headphones": 5000,
    "Tablet": 25000,
    "Keyboard": 3000
}

# Find the item with the highest price
highest_item = max(items, key=items.get)

# Find the item with the lowest price
lowest_item = min(items, key=items.get)

print("Highest priced item:", highest_item, "-", items[highest_item])
print("Lowest priced item:", lowest_item, "-", items[lowest_item])
#output:
Highest priced item: Laptop - 55000
Lowest priced item: Keyboard - 3000

string = input("Enter a string: ")

